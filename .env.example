# ============================================================
# Pratica Debiti AI - MVP - Configurazione
# Copia questo file in ".env" e compila i valori.
# ============================================================

# --- Database (gia configurato per docker-compose, non toccare in locale) ---
DATABASE_URL=postgresql+psycopg://pratica:pratica@db:5432/pratica_debiti
REDIS_URL=redis://redis:6379/0

# --- Storage documenti (locale di default) ---
STORAGE_DIR=/code/storage

# ============================================================
# SCELTA PROVIDER OCR e AI
# Questo e il punto chiave: decidi se usare il CLOUD (consigliato
# per la Fase 0, su documenti ANONIMIZZATI) o il LOCALE (offline).
# ============================================================

# OCR_PROVIDER: "docai" (Google Document AI, cloud) | "tesseract" (locale, offline)
OCR_PROVIDER=tesseract

# LLM_PROVIDER: "gemini" (cloud) | "openai" | "anthropic" | "stub" (finto, per testare il flusso senza API)
LLM_PROVIDER=stub

# --- Credenziali Google Document AI (solo se OCR_PROVIDER=docai) ---
# GOOGLE_APPLICATION_CREDENTIALS=/code/gcp-key.json
# DOCAI_PROJECT_ID=
# DOCAI_LOCATION=eu
# DOCAI_PROCESSOR_ID=

# --- Credenziali LLM (solo se LLM_PROVIDER diverso da stub) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Routing modello per tipo documento: Pro sui documenti ad alta posta
# (centrale_rischi, bilancio, ...), Flash per tutti gli altri.
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# ============================================================
# ARRICCHIMENTO SCHEDA DA FONTI ESTERNE (Openapi / Visengine)
# ============================================================
# enrichment_mode: "stub" (simulato, gratis) | "openapi" (reale, A PAGAMENTO)
ENRICHMENT_MODE=stub
# Token del tuo account Openapi (https://console.openapi.com/oauth)
OPENAPI_TOKEN=
# Dominio: test = sandbox (NON addebita) | produzione = visure reali a pagamento
# sandbox:    https://test.visengine2.altravia.com
# produzione: https://visengine2.altravia.com
OPENAPI_BASE_URL=https://test.visengine2.altravia.com
# Secondi max di attesa risultato visura (oltre i quali ritorna "pending")
OPENAPI_POLL_TIMEOUT=25

# --- Openapi COMPANY (dati azienda IT, sincrona, 100 req/giorno gratis) ---
# Prodotto e token DIVERSI da Visengine. Genera il token dal pannello Company.
COMPANY_TOKEN=
# sandbox: https://test.company.openapi.com | produzione: https://company.openapi.com
COMPANY_BASE_URL=https://test.company.openapi.com
